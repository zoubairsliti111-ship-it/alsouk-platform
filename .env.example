# Supabase — public (browser-safe) credentials used by the supplier directory.
# Both must be set for the directory to load suppliers; without them the app
# shows an explicit error/empty state (there is no bundled mock fallback).
# Find these in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key, or the anon key if that's what your deployment
# provides (the Supabase→Vercel integration injects NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin routes (server-only — NEVER prefix with NEXT_PUBLIC).
# /admin/rfqs and /admin/companies read RLS-protected data with the
# service-role key (bypasses RLS). Access is gated by the caller's signed-in
# session having a row in the `admin_users` table — there is no separate
# token. Find the service-role key in Supabase: Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant (server-only — NEVER prefix with NEXT_PUBLIC).
# The assistant is disabled until AI_API_KEY is set; when unset the widget shows
# a friendly fallback. Any OpenAI-compatible Chat Completions endpoint works —
# override AI_BASE_URL / AI_MODEL for other providers (defaults target OpenAI).
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Live streaming (server-only — NEVER prefix with NEXT_PUBLIC).
# Studio's "Start Live" and the /live/[id] viewer page mint Agora RTC tokens
# via /api/live/*. Both must be set for live streaming to work; without them
# the start-broadcast API returns a 503 and the Studio flow shows an honest
# "not configured" message instead of silently failing. Find these in the
# Agora Console: Project Management → your project → App ID / App Certificate
# (the certificate must be enabled, not left as "primary certificate: unused").
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
